# ==========================================
# BillPro SaaS - Server Environment Config
# ==========================================

PORT=5000
NODE_ENV=development
APP_NAME="BillPro SaaS"

# ------------------------------------------
# Database Connection
# ------------------------------------------
# Local MongoDB (Default) or MongoDB Atlas Cloud URI
MONGODB_URI=mongodb://127.0.0.1:27017/qoutpro

# ------------------------------------------
# Security & JWT Tokens
# ------------------------------------------
JWT_SECRET=billpro_super_secure_jwt_token_secret_key_2026_production
OTP_SECRET=billpro_otp_salt_secret_hmac_key_2026

# ==========================================
# REAL EMAIL DELIVERY (SMTP / Gmail)
# ==========================================
# To receive OTPs directly in your email inbox:
# Option 1: Using Gmail (Fastest & Free)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to "App Passwords": https://myaccount.google.com/apppasswords
# 3. Create an app password (e.g. named "BillPro") -> you will get a 16-letter code like "abcd efgh ijkl mnop"
# 4. Fill in below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-letter-app-password
# SMTP_FROM=your-email@gmail.com

# Option 2: Using Brevo (Free 300 emails/day) or Resend / SendGrid:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@domain.com
# SMTP_PASS=your-brevo-smtp-key

# ==========================================
# REAL SMS DELIVERY (Fast2SMS / Twilio)
# ==========================================
# Option 1: Fast2SMS (Indian Mobile Numbers)
# Get free API Key from: https://www.fast2sms.com/
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio (Global SMS)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
